{
  "name": "mendel-pipeline",
  "version": "4.1.1",
  "description": "The mendel package",
  "main": "src/main.js",
  "bin": {
    "mendel": "src/cli.js"
  },
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "lint": "eslint .",
    "prepack": "node -e \"if(!/pnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('pack/publish with pnpm only')\""
  },
  "author": "Stephan Lee <stephanwlee@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "debug": "^4.4.0",
    "figures": "^6.1.0",
    "mendel-config": "workspace:^",
    "mendel-deps": "workspace:^",
    "mendel-development": "workspace:^",
    "mendel-resolver": "workspace:^",
    "minimatch": "^10.0.0",
    "node-stdlib-browser": "^1.3.1",
    "pretty-ms": "^9.3.0",
    "resolve": "^1.22.10"
  },
  "devDependencies": {
    "rimraf": "^5.0.1",
    "tap": "^21.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
