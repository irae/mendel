{
  "name": "mendel-deps",
  "version": "4.1.1",
  "description": "Depedency detector based on AST. Supports custom cache and custom resolver.",
  "main": "src/index.js",
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "prepack": "node ../../scripts/prepack.js"
  },
  "author": "Stephan Lee <stephanwlee@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "debug": "^4.4.0",
    "postcss": "^8.5.0"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "mendel-resolver": "workspace:^",
    "tap": "^21.0.0"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  }
}
