{
  "name": "mendel-core",
  "version": "4.1.1",
  "description": "Mendel shared dependencies production use",
  "main": "trees.js",
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "prepack": "node -e \"if(!/pnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('pack/publish with pnpm only')\""
  },
  "keywords": [
    "mendel"
  ],
  "author": "Irae Carvalho <irae@irae.pro.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "concentrate": "^0.2.3",
    "debug": "^4.4.0",
    "dissolve": "^0.2.1",
    "mendel-config": "workspace:^",
    "stream-browserify": "^2.0.1",
    "urlsafe-base64": "^1.0.0",
    "xtend": "^4.0.1"
  },
  "devDependencies": {
    "mkdirp": "^3.0.1",
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
