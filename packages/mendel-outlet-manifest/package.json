{
  "name": "mendel-outlet-manifest",
  "version": "4.2.0",
  "description": "Mendel outlet for generating mendel-core (Mendel v1) compatible manifest. Manifest is a serialization of a Mendel cache.",
  "main": "src/index.js",
  "author": "Stephan Lee <stephanwlee@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "debug": "^4.4.0",
    "mendel-manifest-uglify": "workspace:^"
  },
  "devDependencies": {
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "prepack": "node ../../scripts/prepack.js"
  }
}
