  "description": "Mendel transformer for LESS",
  "main": "index.js",
  "mode": "ist",
  "author": "Stephan Lee <stephanwlee@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage --allow-empty-coverage"
