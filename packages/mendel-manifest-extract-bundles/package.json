{
  "name": "mendel-manifest-extract-bundles",
  "version": "4.1.1",
  "description": "Parses a list of manifests, extract common dependencies and expose them from the parent bundle.",
  "main": "manifest-extract.js",
  "keywords": [
    "mendel",
    "mendel-manifest-processor",
    "build"
  ],
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "prepack": "node ../../scripts/prepack.js"
  },
  "author": "Irae Carvalho <irae@irae.pro.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "mendel-development": "workspace:^"
  },
  "devDependencies": {
    "tap": "^21.0.0",
    "tmp": "^0.2.1"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ]
}
