{
  "name": "mendel-transform-babel",
  "version": "4.1.1",
  "description": "Mendel transforms that uses @babel/core",
  "main": "index.js",
  "mode": "ist",
  "keywords": [
    "mendel-ift"
  ],
  "author": "Stephan Lee <stephanwlee@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "debug": "^4.4.0"
  },
  "devDependencies": {
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"if(!/pnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('pack/publish with pnpm only')\""
