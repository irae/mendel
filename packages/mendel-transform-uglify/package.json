{
  "name": "mendel-transform-uglify",
  "version": "4.2.0",
  "description": "Mendel transform to minify javascript using uglify-es",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "keywords": [
    "mendel",
    "transform",
    "uglify"
  ],
  "author": "Irae Carvalho <irae@irae.pro.br>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "dependencies": {
    "debug": "^4.4.0",
    "uglify-js": "^3.19.0"
  },
  "devDependencies": {
    "tap": "^21.7.5"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "prepack": "node ../../scripts/prepack.js"
  }
}
