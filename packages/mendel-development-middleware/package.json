{
  "name": "mendel-development-middleware",
  "version": "4.1.1",
  "description": "Mendel middleware that executes and builds based on a Mendel client appropriate for during development.",
  "main": "index.js",
  "author": "Stephan Lee <stephanwlee@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "mendel-config": "workspace:^",
    "mendel-development": "workspace:^",
    "mendel-exec": "workspace:^",
    "mendel-pipeline": "workspace:^",
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "lint": "eslint .",
    "prepack": "node ../../scripts/prepack.js"
  }
}
