  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "async": "^3.2.4",
    "debug": "^4.4.0",
    "falafel": "^2.2.5",
    "glob": "^13.0.6",
    "resolve": "^1.22.10",
    "shasum": "^1.0.2",
    "through2": "^5.0.11",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
