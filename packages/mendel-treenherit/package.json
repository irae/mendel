{
  "name": "mendel-treenherit",
  "version": "4.1.1",
  "description": "Browserify require transform for folder-based merge. Created for mendel.",
  "main": "index.js",
  "keywords": [
    "mendel",
    "browserify-transform",
    "build"
  ],
  "author": "Irae Carvalho <irae@irae.pro.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "async": "^3.2.6",
    "browser-resolve": "^1.11.1",
    "browserify-transform-tools": "^1.5.3",
    "debug": "^4.4.0"
  },
  "devDependencies": {
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage",
    "prepack": "node -e \"if(!/pnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('pack/publish with pnpm only')\""
  }
}
