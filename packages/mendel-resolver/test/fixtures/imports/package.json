{
    "name": "imports-fixture",
    "private": true,
    "imports": {
        "#app/*": "./src/*.js",
        "#env": {
            "browser": "./src/env.browser.js",
            "default": "./src/env.node.js"
        },
        "#blocked": null,
        "#recursive": "#recursive",
        "#mutual": "#mutual-back",
        "#mutual-back": "#mutual",
        "#outside": "../imports-variational/base/shared.js",
        "#fallback": ["#recursive", "./src/util.js"]
    }
}
