{
  "name": "mendel-requirify",
  "version": "4.1.1",
  "description": "Write individual mendel-requirified dep files from the mendel browserify pipeline.",
  "main": "index.js",
  "keywords": [
    "mendel",
    "browserify-plugin",
    "build"
  ],
  "author": "David Gomez <david.garcia.mx@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "fs-extra": "~0.26.5",
    "mendel-development": "workspace:^",
    "through2": "^2.0.1"
  },
  "devDependencies": {
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
