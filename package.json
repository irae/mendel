{
  "name": "mendel-monorepo",
  "private": true,
  "description": "Build toolchain for experimentation on isomorphic web applications with tree-inheritance and multivariate support.",
  "keywords": [
    "testing",
    "a/b",
    "bucket",
    "multivariate",
    "experiments",
    "evaluation",
    "build-tools",
    "build"
  ],
  "author": "Irae Carvalho <irae@irae.pro.br>",
  "contributors": [
    {
      "name": "David Gomez",
      "email": "david.garcia.mx@gmail.com"
    },
    {
      "name": "Rafael Martins",
      "email": "snit.ram@gmail.com"
    },
    {
      "name": "Stephan Lee",
      "email": "stephanwlee@gmail.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=12.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "bash scripts/link-example-bins.sh --warn",
    "link:example-bins": "bash scripts/link-example-bins.sh --warn",
    "commitlint": "commitlint --edit",
    "prettier": "prettier --write --list-different .",
    "eslint": "eslint --fix .",
    "static": "npm run prettier && npm run eslint",
    "test": "npm run static && npm run unit",
    "unit": "lerna run --no-sort --no-bail test",
    "unit-grouped": "tap ./packages/*/test/*.js --coverage-map=.tap.coverage.map.js --allow-incomplete-coverage",
    "unit-dirty": "tap --allow-incomplete-coverage ./packages/*/test/*.js",
    "unit-legacy": "tap ./test/*.js --allow-incomplete-coverage",
    "coverage": "tap ./packages/*/test/*.js --coverage-map=.tap.coverage.map.js --allow-incomplete-coverage",
    "coverage-html": "tap ./packages/*/test/*.js --coverage-map=.tap.coverage.map.js --allow-incomplete-coverage --coverage-report=lcov",
    "coverage-all-individualy": "for test in $(find packages test -depth 3 -regex '.*test/[^/]*\\.js'); do tap $test --coverage --coverage-map=.tap.coverage.map.js --allow-incomplete-coverage ; done",
    "link:global": "bash scripts/link-global.sh",
    "link:global:once": "bash scripts/link-global.sh 1"
  },
  "nyc": {
    "exclude": [
      "examples/**",
      "coverage/**",
      "test/**"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.4",
    "async": "^3.2.6",
    "browserify": "^17.0.1",
    "debug": "^4.4.3",
    "eslint": "^10.8.1",
    "eslint-plugin-implicit-dependencies": "^1.1.1",
    "eslint-plugin-react": "^7.37.5",
    "express": "^4.21.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "tap": "^21.7.5",
    "temp": "^0.9.4"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
