{
  "name": "mendel-requirify",
  "version": "4.1.1",
  "private": true,
  "description": "Write individual mendel-requirified dep files from the mendel browserify pipeline.",
  "main": "index.js",
  "keywords": [
    "mendel",
    "browserify-plugin",
    "build"
  ],
  "author": "David Gomez <david.garcia.mx@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "fs-extra": "^11.3.6",
    "mendel-development": "workspace:^",
    "through2": "^5.0.11"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "rimraf": "^6.1.3",
    "tap": "^21.0.0"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  },
  "files": [
    "*.js",
    "src",
    "lib",
    "client",
    "docs",
    "legacy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"if(!/pnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('pack/publish with pnpm only')\"",
    "test": "../../node_modules/.bin/tap test/*.js --coverage-map=../../.tap.coverage.map.js --allow-incomplete-coverage"
  }
}
