{
  "name": "mendel-full-example",
  "private": true,
  "version": "4.3.0",
  "description": "Example of app using mendel, es6, jsx, react, server-side-rendering, multivariant and multilayer support.",
  "main": "src/server/index.js",
  "scripts": {
    "postinstall": "bash ../../scripts/link-example-bins.sh --warn",
    "prestart": "bash ../../scripts/link-example-bins.sh",
    "start": "nf start",
    "test": "MENDEL_IPC=.mendelipc-test-offline bash scripts/run-karma-once.sh",
    "pretest-karma-dev": "bash ../../scripts/link-example-bins.sh",
    "test-karma-dev": "MENDEL_IPC=.mendelipc-test bash ../../scripts/wait-for-mendel-socket.sh && MENDEL_IPC=.mendelipc-test karma start test/karma.conf.js --reporters spec --minimal",
    "pretest-karma-debug": "bash ../../scripts/link-example-bins.sh",
    "test-karma-debug": "MENDEL_IPC=.mendelipc-test bash ../../scripts/wait-for-mendel-socket.sh && MENDEL_IPC=.mendelipc-test karma start test/karma.conf.js --reporters spec  --browsers Chrome",
    "prebuild": "bash ../../scripts/link-example-bins.sh",
    "build": "NODE_ENV=production mendel",
    "prebuilder": "bash ../../scripts/link-example-bins.sh",
    "builder": "mendel --watch",
    "pretest-builder": "bash ../../scripts/link-example-bins.sh",
    "test-builder": "MENDEL_IPC=.mendelipc-test MENDEL_ENV=test mendel --watch",
    "predevelopment": "bash ../../scripts/link-example-bins.sh",
    "development": "bash ../../scripts/wait-for-mendel-socket.sh && nodemon src/server/index.js",
    "production": "NODE_ENV=production node src/server/index.js"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "debug": "^4.4.0",
    "express": "^4.18.2",
    "mendel-middleware": "workspace:^",
    "morgan": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-use-measure": "2.1.7"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.29.0",
    "@testing-library/react": "^14.0.0",
    "autoprefixer": "^10.5.0",
    "babel-plugin-istanbul": "^8.0.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "babel-plugin-transform-node-env-inline": "^0.4.3",
    "chai": "^4.3.7",
    "core-js": "^3.49.0",
    "foreman": "^3.0.1",
    "jasmine-core": "^5.1.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-diff-reporter": "^3.0.0",
    "karma-mendel": "workspace:^",
    "karma-spec-reporter": "^0.0.36",
    "mendel-development-middleware": "workspace:^",
    "mendel-generator-extract": "workspace:^",
    "mendel-generator-node-modules": "workspace:^",
    "mendel-manifest-extract-bundles": "workspace:^",
    "mendel-outlet-browser-pack": "workspace:^",
    "mendel-outlet-css": "workspace:^",
    "mendel-outlet-manifest": "workspace:^",
    "mendel-outlet-server-side-render": "workspace:^",
    "mendel-parser-json": "workspace:^",
    "mendel-pipeline": "workspace:^",
    "mendel-transform-babel": "workspace:^",
    "mendel-transform-inline-env": "workspace:^",
    "mendel-transform-uglify": "workspace:^",
    "nodemon": "^3.0.1",
    "rtlcss": "^4.3.0",
    "superagent": "3.8.3"
  },
  "contributors": [
    {
      "name": "Irae Carvalho",
      "email": "irae@irae.pro.br"
    },
    {
      "name": "David Gomez",
      "email": "david.garcia.mx@gmail.com"
    }
  ],
  "keywords": [
    "mendel",
    "app",
    "example"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irae/mendel.git"
  },
  "homepage": "https://github.com/irae/mendel#readme",
  "bugs": {
    "url": "https://github.com/irae/mendel/issues"
  }
}
